# Copy to .env (git-ignored) and fill in.
# Free key: https://quickstats.nass.usda.gov/api
NASS_API_KEY=
# Chatbot (backend only, never in the frontend). Free Gemini key from Google AI Studio.
# On Vercel set it as an environment variable instead.
LLM_API_KEY=
# Optional chatbot settings
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-3-flash-preview
# CHAT_ALLOWED_ORIGINS=https://your-frontend.example   (comma separated, default: no cross-origin access)
# CHAT_RATE_PER_MIN=20
